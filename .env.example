# Application Environment
ENVIRONMENT=development
SECRET_KEY=super_secure_random_key_replace_this_with_64_characters_min
# Set to true only while debugging SQL; it logs every statement.
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
REDIS_MAX_CONNECTIONS=100
AUTH_PASSWORD_HASH_WORKERS=4
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.05
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_RELEASE=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.05
UPTIME_API_HEARTBEAT_URL=
UPTIME_WORKER_HEARTBEAT_URL=
UPTIME_OBSERVABILITY_HEARTBEAT_URL=
UPTIME_HEARTBEAT_INTERVAL_SECONDS=60
FRONTEND_INTERNAL_HEALTH_URL=http://frontend:5173/
FRONTEND_URL=http://localhost:5173
VITE_API_URL=/api/v1
VITE_API_PROXY_TARGET=http://localhost:8000

# PostgreSQL
POSTGRES_USER=chess_admin
POSTGRES_PASSWORD=chess_secure_pass_2025
POSTGRES_DB=chess_academy
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://chess_admin:chess_secure_pass_2025@localhost:5432/chess_academy

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Meilisearch (server-side key; keep the master key private)
MEILISEARCH_MASTER_KEY=local-development-only-change-before-deploying
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=local-development-only-change-before-deploying

# Mail Configuration (Mailpit for dev)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@chessacademy.com
MAIL_FROM_NAME=Thirumal Chess Academy
SMTP_USE_TLS=false
SMTP_USE_SSL=false

# Local-only monitoring login and notifications (observability Compose profile)
GRAFANA_ADMIN_USER=academy-admin
GRAFANA_ADMIN_PASSWORD=local-only-change-this-password
ALERT_EMAIL_TO=alerts@example.test
ALERT_WEBHOOK_URL=
ALERT_SMTP_HOST=mailpit
ALERT_SMTP_PORT=1025
ALERT_SMTP_FROM=no-reply@chessacademy.com
ALERT_SMTP_USERNAME=
ALERT_SMTP_PASSWORD=
ALERT_SMTP_REQUIRE_TLS=false

