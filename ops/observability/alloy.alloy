logging {
  level  = "info"
  format = "logfmt"
}

discovery.docker "academy" {
  host             = "tcp://docker-socket-proxy:2375"
  refresh_interval = "5s"
}

discovery.relabel "academy" {
  targets = discovery.docker.academy.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    regex         = "^(thirumalchessacademyappointments|chess-academy-oci|chess-academy-production)$"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "service_name"
  }
}

loki.source.docker "academy" {
  host          = "tcp://docker-socket-proxy:2375"
  targets       = discovery.docker.academy.targets
  labels        = { job = "docker", environment = "academy" }
  relabel_rules = discovery.relabel.academy.rules
  forward_to    = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
