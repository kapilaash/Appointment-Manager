# Normalise line endings in the repository; check text files out natively.
* text=auto

# Files executed or parsed inside Linux containers must keep LF even on Windows checkouts.
*.sh text eol=lf
*.conf text eol=lf
Dockerfile text eol=lf
**/Caddyfile text eol=lf
*.alloy text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

*.png binary
*.woff2 binary
