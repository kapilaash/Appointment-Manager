PUBLIC_HOSTNAME=chess.example.com
SITE_ACCESS_USER=academy-access
SITE_ACCESS_PASSWORD_HASH=REPLACE_WITH_CADDY_BCRYPT_HASH
POSTGRES_DB=chess_academy_prod
POSTGRES_SUPERUSER=chess_owner_prod
POSTGRES_SUPERUSER_PASSWORD=REPLACE_WITH_RANDOM_HEX_SECRET
POSTGRES_APP_USER=chess_app_prod
POSTGRES_APP_PASSWORD=REPLACE_WITH_RANDOM_HEX_SECRET
POSTGRES_READONLY_USER=chess_reader_prod
POSTGRES_READONLY_PASSWORD=REPLACE_WITH_RANDOM_HEX_SECRET
REDIS_PASSWORD=REPLACE_WITH_RANDOM_HEX_SECRET
MEILISEARCH_MASTER_KEY=REPLACE_WITH_RANDOM_HEX_SECRET
SECRET_KEY=REPLACE_WITH_RANDOM_HEX_SECRET
SESSION_MAX_AGE_SECONDS=604800
# Per-process limits: budget total DB connections across every API and worker replica.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
REDIS_MAX_CONNECTIONS=100
# Bound CPU and memory-intensive Argon2 work per API process.
AUTH_PASSWORD_HASH_WORKERS=4
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.05
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_RELEASE=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_ORG=
SENTRY_PROJECT=
UPTIME_API_HEARTBEAT_URL=
UPTIME_WORKER_HEARTBEAT_URL=
UPTIME_OBSERVABILITY_HEARTBEAT_URL=
UPTIME_HEARTBEAT_INTERVAL_SECONDS=60
FRONTEND_INTERNAL_HEALTH_URL=http://frontend:80/
# Free, low-volume Gmail SMTP. Use a dedicated academy Gmail account.
# Turn on 2-Step Verification and create an App Password in Google Account security.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=YOUR_ACADEMY_ACCOUNT@gmail.com
SMTP_PASSWORD=REPLACE_WITH_GOOGLE_APP_PASSWORD
SMTP_USE_TLS=true
SMTP_USE_SSL=false
MAIL_FROM=YOUR_ACADEMY_ACCOUNT@gmail.com
MAIL_FROM_NAME=Thirumal Chess Academy

# Monitoring endpoints bind to localhost. Replace these before enabling the profile.
GRAFANA_ADMIN_USER=academy-admin
GRAFANA_ADMIN_PASSWORD=
ALERT_EMAIL_TO=
ALERT_WEBHOOK_URL=
ALERT_SMTP_HOST=smtp.gmail.com
ALERT_SMTP_PORT=587
ALERT_SMTP_FROM=YOUR_ACADEMY_ACCOUNT@gmail.com
ALERT_SMTP_USERNAME=YOUR_ACADEMY_ACCOUNT@gmail.com
ALERT_SMTP_PASSWORD=
ALERT_SMTP_REQUIRE_TLS=true
